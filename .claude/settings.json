{
  "permissions": {
    "allow": [
      "Bash(./gradlew assembleDebug *)",
      "Bash(./gradlew test *)",
      "Bash(./gradlew ktlintCheck *)",
      "Bash(./gradlew detekt *)",
      "Bash(./gradlew lint *)",
      "Bash(./gradlew koverHtmlReport *)",
      "Bash(./gradlew koverVerify *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-prod-db.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-kotlin-rules.py"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-sdlc-baseline.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scan-secrets.sh"
          }
        ]
      }
    ]
  }
}
